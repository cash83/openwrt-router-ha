{
  "config": {
    "step": {
      "user": {
        "title": "OpenWrt router",
        "description": "Address and login of the main router. Other OpenWrt access points of the same network are found on their own and use the same login.",
        "data": {
          "host": "Address",
          "username": "User name",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Log in to the router again",
        "description": "The router refused the saved login.",
        "data": {
          "username": "User name",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "The router did not answer at that address.",
      "invalid_auth": "Wrong user name or password."
    },
    "abort": {
      "already_configured": "This router is already set up.",
      "reauth_successful": "Login updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "OpenWrt network options",
        "data": {
          "scan_interval": "Seconds between two readings",
          "show_panel": "Show the Wi-Fi page in the sidebar",
          "notify_service": "Notify when a new device joins",
          "track_all_clients": "Create a device for every client",
          "tracked_clients": "Clients to follow"
        },
        "data_description": {
          "notify_service": "Name of a notify service, for example notify.mobile_app_my_phone. Leave empty for no notification; the event openwrt_router_new_device is fired either way.",
          "tracked_clients": "Each one gets a presence tracker, its signal, the node it is on and an internet access switch."
        }
      }
    }
  },
  "services": {
    "kick_client": {
      "name": "Disconnect a client",
      "description": "Disconnects a Wi-Fi client so that it joins the access point it hears best.",
      "fields": {
        "mac": {
          "name": "Hardware address",
          "description": "Address of the client."
        },
        "ban_seconds": {
          "name": "Keep away for",
          "description": "Seconds during which the node it was on refuses it."
        },
        "entry_id": {
          "name": "Network",
          "description": "Only needed with more than one OpenWrt network."
        }
      }
    },
    "block_client": {
      "name": "Block internet for a client",
      "description": "Adds or removes a firewall rule that keeps a client off the internet.",
      "fields": {
        "mac": {
          "name": "Hardware address",
          "description": "Address of the client."
        },
        "blocked": {
          "name": "Blocked",
          "description": "On to block, off to allow again."
        },
        "entry_id": {
          "name": "Network",
          "description": "Only needed with more than one OpenWrt network."
        }
      }
    }
  },
